# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for User Authentication
JWT_SECRET=travelmate_super_secret_jwt_key_2026

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# If left empty, TravelMate automatically runs with a built-in persistent storage adapter so it works out-of-the-box!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/travelmate?retryWrites=true&w=majority

# Optional: Google Maps Platform API Key (Leaflet + OpenStreetMap is enabled by default with zero key required)
VITE_GOOGLE_MAPS_API_KEY=
